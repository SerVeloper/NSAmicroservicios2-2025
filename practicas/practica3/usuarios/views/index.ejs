<!DOCTYPE html>
<html>
<head>
  <title>Lista de Usuarios</title>
</head>
<body>
  <h1>Usuarios Registrados</h1>
  <a href="/nuevo">Agregar Usuario</a>
  <table border="1" cellpadding="5">
    <tr>
      <th>ID</th>
      <th>Nombre</th>
      <th>Correo</th>
      <th>Fecha Registro</th>
      <th>Acciones</th>
    </tr>
    <% usuarios.forEach(usuario => { %>
      <tr>
        <td><%= usuario.id %></td>
        <td><%= usuario.nombre %></td>
        <td><%= usuario.correo %></td>
        <td><%= usuario.created_at ? usuario.created_at.toISOString().slice(0,19).replace("T"," ") : 'Sin fecha' %></td>
        <td>
          <form action="/eliminar/<%= usuario.id %>" method="POST" style="display:inline;">
            <button type="submit">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
