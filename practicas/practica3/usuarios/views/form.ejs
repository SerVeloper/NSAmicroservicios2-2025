<!DOCTYPE html>
<html>
<head>
  <title>Nuevo Usuario</title>
</head>
<body>
  <h1>Agregar Usuario</h1>
  <form action="/nuevo" method="POST">
    <label>Nombre:</label>
    <input type="text" name="nombre" required><br><br>
    <label>Correo:</label>
    <input type="email" name="correo" required><br><br>
    <button type="submit">Registrar</button>
  </form>
  <br>
  <a href="/">Volver</a>
</body>
</html>
