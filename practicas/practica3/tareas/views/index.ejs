<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Gestión de Tareas</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
    button { background-color: #ff4444; color: white; border: none; padding: 5px 10px; cursor: pointer; }
    button:hover { background-color: #cc0000; }
    a { color: #0066cc; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <h1>Lista de Tareas</h1>
  <a href="/tasks/nuevo">Crear Nueva Tarea</a>
  <table>
    <thead>
      <tr>
        <th>Título</th>
        <th>Descripción</th>
        <th>Estado</th>
        <th>Fecha de Creación</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% tasks.forEach(task => { %>
        <tr>
          <td><%= task.titulo %></td>
          <td><%= task.descripcion %></td>
          <td><%= task.estado %></td>
          <td><%= task.fechaCreacion ? task.fechaCreacion.toISOString().slice(0,19).replace("T"," ") : 'Sin fecha' %></td>
          <td>
            <a href="/tasks/editar/<%= task._id %>">Editar</a>
            <form action="/tasks/eliminar/<%= task._id %>" method="POST" style="display:inline;">
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>